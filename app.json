{
  "expo": {
    "name": "instantcards",
    "slug": "instantcards",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A1628"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.instantcards.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Used to authenticate your identity when revealing card details.",
        "NSCameraUsageDescription": "Used to capture KYC documents."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A1628"
      },
      "package": "com.instantcards.app",
      "versionCode": 1,
      "permissions": ["USE_BIOMETRIC", "USE_FINGERPRINT", "CAMERA"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#00C896",
          "sounds": []
        }
      ]
    ],
    "scheme": "instantcards",
    "experiments": {
      "typedRoutes": true
    }
  }
}
